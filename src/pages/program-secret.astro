---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Секретная программа";

const talks = [
  {
    time: "14:00",
    speaker: "Дима Френкель",
    title: "БАНКИ: ОТ КАЗНАЧЕЯ ДО НЕОБАНКА",
  },
  {
    time: "15:00",
    speaker: "ZEN",
    title: "Wi-Fi ПОД МИКРОСКОПОМ",
  },
  {
    time: "16:30",
    speaker: "Дмитрий Миттов",
    title: "Homo Lycra",
  },
  {
    time: "17:00",
    speaker: "Арина Борзистая",
    title: "КАК СТАТЬ КИБОРГОМ",
  },
];

const afternoonTalks = talks.slice(0, 2);
const lateTalks = talks.slice(2);

const evening = [
  { time: "19:00", title: "Гриль" },
  { time: "21:00", title: "Музквиз" },
  { time: "22:00", title: "Аукцион и подарки" },
];
---

<BaseLayout pageTitle={pageTitle}>
  <section class="program">
    <p class="kicker">22 августа</p>
    <h2>Программа на день</h2>

    <div class="timeline" aria-label="Программа конференции">
      <article class="event highlight">
        <time datetime="12:30">12:30</time>
        <div>
          <h3>Мастер-класс по скетчингу</h3>
          <p>Сергей</p>
        </div>
      </article>

      <article class="event section-start">
        <time datetime="14:00">14:00</time>
        <div>
          <h3>Начало спикерской программы</h3>
        </div>
      </article>

      {afternoonTalks.map((talk) => (
        <article class="event talk-event">
          <time datetime={talk.time}>{talk.time}</time>
          <div>
            <p class="speaker">{talk.speaker}</p>
            <h3>{talk.title}</h3>
          </div>
        </article>
      ))}

      <article class="event lunch">
        <time>после 15:00</time>
        <div>
          <h3>Обед</h3>
        </div>
      </article>

      {lateTalks.map((talk) => (
        <article class="event talk-event">
          <time datetime={talk.time}>{talk.time}</time>
          <div>
            <p class="speaker">{talk.speaker}</p>
            <h3>{talk.title}</h3>
          </div>
        </article>
      ))}

      {evening.map((item) => (
        <article class="event evening-event">
          <time datetime={item.time}>{item.time}</time>
          <div>
            <h3>{item.title}</h3>
          </div>
        </article>
      ))}
    </div>

    <aside class="transport">
      <h2>Как уехать</h2>
      <p>Последняя RE-шка до KW в 00:04.</p>
      <p>S-Bahn от KW ходит всю ночь.</p>
    </aside>
  </section>
</BaseLayout>

<style>
  :global(main) {
    max-width: 860px;
    margin: 0 auto;
  }

  :global(main > h1) {
    margin-bottom: 0.75rem;
  }

  .program {
    padding-bottom: 4rem;
  }

  .kicker {
    margin: 0 0 0.5rem;
    color: #45591f;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .program > h2 {
    margin-top: 0;
    font-size: clamp(2.2rem, 8vw, 4.8rem);
    line-height: 0.95;
    color: #45591f;
  }

  .timeline {
    display: grid;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .event {
    display: grid;
    grid-template-columns: minmax(74px, 112px) 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1rem 0;
    border-top: 1px solid rgba(69, 89, 31, 0.26);
  }

  .event time {
    font-family: "Practice Mono", monospace;
    color: #45591f;
    font-size: 1.15rem;
    line-height: 1.1;
  }

  .event h3 {
    margin: 0;
    font-family: "Manrope", sans-serif;
    font-size: clamp(1.15rem, 3vw, 1.7rem);
    line-height: 1.15;
    color: #111;
  }

  .event p {
    margin: 0.25rem 0 0;
  }

  .speaker {
    color: #45591f;
    font-weight: 700;
  }

  .highlight {
    border-top-width: 2px;
  }

  .highlight h3,
  .section-start h3,
  .evening-event h3 {
    color: #45591f;
  }

  .lunch {
    padding: 0.8rem 0;
  }

  .lunch h3 {
    color: #99aa6f;
  }

  .transport {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 2px solid rgba(69, 89, 31, 0.34);
  }

  .transport h2 {
    margin-top: 0;
    color: #45591f;
  }

  .transport p {
    margin: 0.35rem 0;
    font-size: 1.05rem;
  }

  @media (max-width: 635px) {
    .event {
      grid-template-columns: 76px 1fr;
      gap: 0.7rem;
    }

    .event time {
      font-size: 1rem;
    }
  }
</style>
