---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = ''
import Greeting from "../components/Greeting";
---

<BaseLayout pageTitle={pageTitle}>
  <div class="text-neutral-900">
    <section class="mb-8 text-justify text-center home-hero">
      <h1 style="font-family: 'Practice', sans-serif;">НОЙКОНФ</h1>
      <h2 style="font-family: 'Manrope', sans-serif;">Кэмп выходного дня: IT-рейв и митап-вечеринка в бранденбуржском подберлинье</h2>
      <p style="font-family: 'Manrope', sans-serif;">Куммерсдорф, Берлин</p>
      <p style="font-family: 'Manrope', sans-serif;">Август-Сентябрь 2026</p>
    </section>

    <section class="main-image">
      <img src="/gallery/9_25/Neuconf_018.jpg" alt="Main visual" />
    </section>
  </div>
</BaseLayout>

<style>
  :global(main > h1) {
    display: none;
  }
  @media (max-width: 635px) {
    .home-hero {
      margin-top: 10vh;
      text-align: left;
    }
    .main-image {
      margin-top: 2.5rem;
    }
  }
  @media (min-width: 636px) {
    :global(body) {
      height: 100vh;
      overflow: hidden;
    }
    :global(main) {
      flex: 1;
    }
    .home-hero {
      margin-top: 1.5rem;
    }
    .main-image {
      width: 100vw;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
      position: relative;
      margin-top: -8.5rem;
    }
    .main-image img {
      max-height: 470px;
      object-fit: cover;
      object-position: center 15%;
      transform: scaleX(-1);
    }
  }
</style>
