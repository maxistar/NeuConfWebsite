---
const platform = "github";
const username = "withastro";
import Social from './Social.astro';
---
<style>
    footer {
        display: flex;
        gap: 0.5rem;
        margin-top: 2rem;
        justify-content: center;
        flex-wrap: wrap;
        align-items: center;
    }
    a {
        margin: 0;
    }
    @media (max-width: 635px) {
        footer {
            gap: 0.35rem;
        }
    }
</style>
<footer>
    <Social platform="github" link="https://github.com/maxistar/NeuConfWebsite/tree/main" />
    <Social platform="telegram" link="https://t.me/neuconf" />
    <Social platform="instagram" link="https://www.instagram.com/neuconf_berlin" />
    <Social platform="contacts" link="/contacts/" />
</footer>
